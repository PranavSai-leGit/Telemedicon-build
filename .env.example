# MediTale Environment Configuration

# Application
APP_NAME=MediTale
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production-1234567890abcdef
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database (PostgreSQL with psycopg3)
DATABASE_URL=postgresql+psycopg://meditale_user:meditale_password@localhost:5432/meditale

# Security & Sessions
SESSION_COOKIE_NAME=meditale_session
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Private File Storage
STORAGE_DIR=private_uploads
MAX_FILE_SIZE_MB=10

# AI / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_MODE=auto
# AI_MODE options: "auto" (uses Gemini if API key set, fallback to demo mode otherwise), "gemini" (strict Gemini), "demo" (synthetic demo mode)
